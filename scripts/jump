#!/bin/bash

set -euo pipefail

PROJECTS_DIRS=(
  '/Users/evanthomas/github.com/ethomas2'
  '/Users/evanthomas/github.com/simple-ai-lab'
)
EXTRA_DIRS=(
  "$HOME/scripts"
)

list_repositories() {
  ## List repo directories sorted by modification time across all project dirs + extras.
  for dir in "${PROJECTS_DIRS[@]}"; do
    [[ -d "$dir" ]] && gfind "$dir" -maxdepth 1 -type d -printf '%T+ %p\n'
  done | sort -k1 | cm 2
  for dir in "${EXTRA_DIRS[@]}"; do
    [[ -d "$dir" ]] && printf '%s\n' "$dir"
  done
}

find_repo_root() {
  ## Walk up from $PWD (or $REPO_ROOT) to find .git or .envrc.
  if [[ -n "${REPO_ROOT:-}" ]]; then
    printf '%s\n' "$REPO_ROOT"
    return 0
  fi

  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -e "$dir/.git" || -e "$dir/.envrc" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

list_worktrees() {
  ## List worktree directories under <repo_root>/worktrees.
  local repo_root
  if ! repo_root="$(find_repo_root)"; then
    return 1
  fi

  local worktrees_dir
  worktrees_dir="$(cd "$repo_root" && pwd)/worktrees"

  if [[ ! -d "$worktrees_dir" ]]; then
    return 1
  fi

  find "$worktrees_dir" -mindepth 1 -maxdepth 1 -type d | sort
}


list_marks() {
  ## List directories referenced by marks in $MARKS_DIR.
  MARKS_DIR="${MARKPATH:-$HOME/.marks}"
  [[ -d "$MARKS_DIR" ]] || return 1

  local mark
  while IFS= read -r mark; do
    [[ -d "$mark" ]] || continue
    (
      cd "$mark"
      pwd -P
    )
  done < <(find "$MARKS_DIR" -mindepth 1 -maxdepth 1 | sort) | sort -u
}

main() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is required but not installed" >&2
    exit 1
  fi

  local context="${1:-}"

  case "$context" in
    repositories)
      list_repositories | fzf
      ;;
    marks)
      local marks
      marks="$(list_marks)" || { echo "No marks found" >&2; exit 1; }
      printf '%s\n' "$marks" | fzf
      ;;
    worktree)
      local wt
      wt="$(list_worktrees)" || { echo "No worktrees found" >&2; exit 1; }
      printf '%s\n' "$wt" | fzf
      ;;
    "")
      # Combine all contexts; silently skip any that fail
      {
        list_repositories 2>/dev/null || true
        list_worktrees 2>/dev/null || true
        list_marks 2>/dev/null || true
      } | fzf
      ;;
    *)
      echo "Unknown context: $context" >&2
      echo "Usage: jump [repositories|marks|worktree]" >&2
      exit 1
      ;;
  esac
}

main "$@"
