#!/usr/bin/env -S uv run --script
# vim: set filetype=python :
# /// script
# requires-python = ">=3.8"
# ///

import sys
import re
import pathlib


def find_git_root(start_path: pathlib.Path) -> pathlib.Path:
    """Walk up from start_path to find a directory containing .git/"""
    current = start_path.resolve()

    while current != current.parent:
        if (current / ".git").is_dir():
            return current
        current = current.parent

    raise FileNotFoundError("Could not find .git/ directory in current path")


def update_or_create_envrc(envrc_path: pathlib.Path, var_name: str, var_value: str):
    """Append new export value right after the latest occurrence of the variable"""
    export_line = f"export {var_name}={var_value}"
    pattern = re.compile(f"^export {re.escape(var_name)}\s*=.*$", re.MULTILINE)

    if not envrc_path.exists():
        envrc_path.write_text("")
        print("Created new envrc")

    content = envrc_path.read_text()
    lines = content.splitlines(keepends=True)

    # Find the last occurrence of the variable
    last_match_idx = next(
        (i for i, line in enumerate(lines) if pattern.match(line)), len(lines) - 1
    )

    # Insert the new export right after the last occurrence
    lines.insert(last_match_idx + 1, f"{export_line}\n")
    envrc_path.write_text("".join(lines))
    print(f"Added {var_name} to {envrc_path} (after existing occurrences)")


def main():
    if len(sys.argv) != 2:
        print("Error: No arguments provided", file=sys.stderr)
        print("Usage: envrc-export FOO=bar", file=sys.stderr)
        sys.exit(1)

    export_arg = sys.argv[1]

    # Validate format: VARIABLE=value
    if not re.match(r"^[a-zA-Z_][a-zA-Z0-9_]*=.*$", export_arg):
        print("Error: Invalid format. Expected: VARIABLE=value", file=sys.stderr)
        sys.exit(1)

    # Extract variable name and value
    var_name, var_value = export_arg.split("=", 1)

    # Find git root
    try:
        git_root = find_git_root(pathlib.Path.cwd())
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    envrc_path = git_root / ".envrc"

    # Update or create .envrc
    update_or_create_envrc(envrc_path, var_name, var_value)


if __name__ == "__main__":
    main()
