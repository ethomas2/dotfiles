#!/Users/evanthomas/.dotfiles/scripts/venv-stopwatch/bin/python

from __future__ import annotations

import pytest
import argparse
import re
import time
import datetime

import dateparser


def _no_curses(offset: TimeOffset | None = None, title: str | None = None):
    now = time.time()

    while True:
        elapsed = time.time() - now + (offset.offset_seconds if offset else 0)

        hours, remainder = divmod(int(elapsed), 3600)
        minutes, seconds = divmod(remainder, 60)
        elapsed_time = f"{hours:02}:{minutes:02}:{seconds:02}"
        # https://stackoverflow.com/questions/37774983/clearing-the-screen-by-printing-a-character
        print("\033c")
        if title:
            print(title, end="\n\r")
        print(elapsed_time, end="\n\r")
        time.sleep(1)


def _curses(offset: TimeOffset | None = None, title: str | None = None):
    import curses

    def _run(stdscr):
        # Initialize curses
        curses.curs_set(0)  # Hide the cursor
        stdscr.clear()  # Clear the screen

        now = time.time()
        while True:
            # Clear the screen on each iteration to prevent artifacts from resizes
            stdscr.clear()
            # Calculate elapsed time
            elapsed = time.time() - now + (offset.offset_seconds if offset else 0)
            hours, remainder = divmod(int(elapsed), 3600)
            minutes, seconds = divmod(remainder, 60)
            elapsed_time = f"{hours:02}:{minutes:02}:{seconds:02}"

            # Display elapsed time in the center of the screen
            height, width = stdscr.getmaxyx()

            # Display title if provided
            if title:
                title_x = width // 2 - len(title) // 2
                title_y = min(5, height // 2)
                stdscr.addstr(title_y, title_x, title, curses.A_BOLD)

            # Display elapsed time
            x = width // 2 - len(elapsed_time) // 2
            y = height // 2
            stdscr.addstr(y, x, elapsed_time)
            stdscr.refresh()

            time.sleep(1)

    curses.wrapper(_run)


class TimeOffset:
    def __init__(self, offset_seconds: int):
        self.offset_seconds = offset_seconds

    @classmethod
    def parse(cls, time_str: str) -> TimeOffset | None:
        """
        time_str is like 5m, 1h, '5minutes', '5 minutes', '1 hour'
        """
        pattern = r"(?P<value>\d+)\s*(?P<unit>\w+)$"
        m = re.match(pattern, time_str)
        if m is None:
            return None

        value = int(m.group("value"))
        unit = m.group("unit")

        conversion = {
            "m": 60,
            "minute": 60,
            "minutes": 60,
            "h": 3600,
            "hour": 3600,
            "hours": 3600,
            "s": 1,
            "second": 1,
            "seconds": 1,
        }.get(unit)
        if conversion is None:
            raise ValueError(f"Unknown unit {unit}")
        return TimeOffset(conversion * value)

    @classmethod
    def parse_since(cls, time_str: str) -> TimeOffset:
        """
        Parse a human-readable timestamp like "5:00 AM", "5am", "9:30 PM", etc.
        Returns a TimeOffset representing the time elapsed since that timestamp.
        Raises ValueError if parsing fails or is ambiguous.
        """
        # Use dateparser with settings to prefer recent dates and handle ambiguity
        # RELATIVE_BASE set to now helps with ambiguous dates
        now = datetime.datetime.now()
        settings = {
            # makes it so that if you pass in a date with an ambiguous date
            # (e.g. "5:00 AM") at 2 PM with no date, it assumes today
            "RELATIVE_BASE": now,
            "PREFER_DATES_FROM": "past",  # Prefer past dates for times like "5:00 AM"
        }

        parsed = dateparser.parse(time_str, settings=settings)

        if parsed is None:
            raise ValueError(
                f"Could not parse timestamp '{time_str}'. "
                "Please provide a time like '5:00 AM', '5am', '9:30 PM', etc."
            )

        # Check for ambiguity
        time_diff = (parsed - now).total_seconds()

        # Calculate offset: negative because we want to add time that has already elapsed
        # If parsed time is in the past, offset should be positive (time has elapsed)
        # If parsed time is in the future, offset should be negative (time hasn't elapsed yet)
        offset_seconds = int(-time_diff)

        return TimeOffset(offset_seconds)


def test_time_offset():
    good_patterns = [
        ("5m", 300),
        ("5 m", 300),
        ("5minutes", 300),
        ("5 minutes", 300),
        ("5s", 5),
        ("5 second", 5),
        ("5hour", 18_000),
        ("5h", 18_000),
    ]
    for time_str, expected_offset in good_patterns:
        o = TimeOffset.parse(time_str)
        assert o is not None, f"Expected {time_str} to parse, got None"
        assert (
            o.offset_seconds == expected_offset
        ), f"Expected {expected_offset=} for {time_str=} got {o.offset_seconds=}"


def test_parse_since():

    o1 = TimeOffset.parse_since("5m")
    print(o1.offset_seconds)

    o2 = TimeOffset.parse_since("2025-11-8 10:00")
    print(o2.offset_seconds)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--no-curses", action="store_true", help="Use plain text instead of curses"
    )
    parser.add_argument(
        "--title",
        type=str,
        required=False,
        help="Title to display above the stopwatch",
    )

    # Create a mutually exclusive group for --offset and --since
    time_group = parser.add_mutually_exclusive_group()
    time_group.add_argument(  # TODO: remove this. No need for --offset. --since handles it
        "--offset",
        type=TimeOffset.parse,
        required=False,
        help="Time offset duration (e.g., '5m', '1h', '30 minutes')",
    )
    time_group.add_argument(
        "--since",
        type=TimeOffset.parse_since,
        required=False,
        help="Start time as human-readable timestamp (e.g., '5:00 AM', '9:30 PM', '5am')",
    )

    args = parser.parse_args()

    offset = args.since if args.since is not None else args.offset

    if args.no_curses:
        _no_curses(offset=offset, title=args.title)
    else:
        _curses(offset=offset, title=args.title)


if __name__ == "__main__":
    main()
