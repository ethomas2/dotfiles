#!/usr/bin/env -S uv run --script
# vim: set filetype=python :
# /// script
# requires-python = ">=3.8"
#
# ///

from __future__ import annotations

import argparse
import curses
import re
import subprocess
import time
from datetime import datetime, timedelta


def parse_loop_duration(s: str) -> float:
    """Parse a duration string like '5s', '5m', '5h' into seconds."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smh])", s.strip())
    if not m:
        raise argparse.ArgumentTypeError(
            f"Invalid duration '{s}'. Use e.g. 5s, 5m, 5h"
        )
    value = float(m.group(1))
    unit = m.group(2)
    multipliers = {"s": 1, "m": 60, "h": 3600}
    return value * multipliers[unit]


def parse_when(s: str) -> datetime:
    """
    Parse either a duration ('5s', '10m', '2h') or a clock time ('14:30', '2:30pm', '5p').
    Returns a target datetime either way.
    """
    # Try duration first
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smh])", s.strip())
    if m:
        value = float(m.group(1))
        unit = m.group(2)
        multipliers = {"s": 1, "m": 60, "h": 3600}
        return datetime.now().replace(microsecond=0) + timedelta(seconds=value * multipliers[unit])

    # Try clock time
    normalized = s.strip()
    normalized = re.sub(r"\s+(am|pm|a|p)\b", r"\1", normalized, flags=re.IGNORECASE)
    normalized = re.sub(r"([ap])$", r"\1m", normalized, flags=re.IGNORECASE)
    for fmt in ("%H:%M", "%I:%M%p", "%I%p"):
        try:
            t = datetime.strptime(normalized, fmt).time()
            target = datetime.now().replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)
            if target <= datetime.now():
                raise argparse.ArgumentTypeError(
                    f"Time '{s}' has already passed today."
                )
            return target
        except ValueError:
            continue

    raise argparse.ArgumentTypeError(
        f"Invalid value '{s}'. Use a duration (5s, 5m, 5h) or a time (14:30, 2:30pm, 5p)"
    )


def countdown_sleep(target: datetime, message: str):
    """Show a full-screen ncurses countdown until target time."""
    def _run(stdscr: curses.window):
        curses.curs_set(0)
        curses.use_default_colors()
        stdscr.timeout(200)

        while True:
            remaining = (target - datetime.now()).total_seconds()
            if remaining <= 0:
                break

            h = int(remaining // 3600)
            m = int((remaining % 3600) // 60)
            s = int(remaining % 60)
            countdown_str = f"{h:02d}:{m:02d}:{s:02d}"
            target_str = target.strftime("%-I:%M %p")

            stdscr.erase()
            rows, cols = stdscr.getmaxyx()
            mid_y = rows // 2

            # Draw countdown big and centered
            stdscr.addstr(mid_y - 1, max(0, (cols - len(countdown_str)) // 2), countdown_str, curses.A_BOLD)
            # Draw message and target time below
            info = f"{message}  ·  {target_str}"
            stdscr.addstr(mid_y + 1, max(0, (cols - len(info)) // 2), info, curses.A_DIM)
            # Quit hint
            hint = "ctrl-c to cancel"
            stdscr.addstr(rows - 1, max(0, (cols - len(hint)) // 2), hint, curses.A_DIM)

            stdscr.refresh()
            key = stdscr.getch()
            if key == 3:  # ctrl-c
                raise KeyboardInterrupt

    curses.wrapper(_run)


def send_alert(message: str, sound: str = "Basso"):
    """Send a macOS notification via terminal-notifier."""
    subprocess.run(
        [
            "terminal-notifier",
            "-title", message,
            "-message", message,
            "-sound", sound,
        ],
        check=True,
    )


def main():
    parser = argparse.ArgumentParser(
        description="Send a macOS notification via terminal-notifier."
    )
    parser.add_argument("message", help="Notification title and message text")
    parser.add_argument(
        "--at", "--delay",
        type=parse_when,
        dest="when",
        metavar="WHEN",
        help="Duration (5s, 5m, 5h) or clock time (14:30, 2:30pm, 5p)",
    )
    parser.add_argument(
        "--loop",
        type=parse_loop_duration,
        metavar="INTERVAL",
        help="Repeat every interval (e.g. 5s, 5m, 5h)",
    )
    parser.add_argument(
        "--sound",
        default="Basso",
        help="Notification sound (default: Basso)",
    )

    args = parser.parse_args()

    if args.when:
        countdown_sleep(args.when, args.message)

    if args.loop:
        while True:
            send_alert(args.message, sound=args.sound)
            time.sleep(args.loop)
    else:
        send_alert(args.message, sound=args.sound)


if __name__ == "__main__":
    main()
