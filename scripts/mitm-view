#!/Users/evanthomas/.dotfiles/scripts/venv-mitm-view/bin/python
from __future__ import annotations

import argparse
import csv
import json
import sys
import pathlib
from typing import Iterable, TextIO

import matplotlib.pyplot as plt
from mitmproxy.http import HTTPFlow
from mitmproxy.io import FlowReader


FIELDS = [
    "index",
    "start_ts",
    "end_ts",
    "duration_s",
    "method",
    "host",
    "path",
    "status_code",
]


def iter_flows(dump_path: pathlib.Path) -> Iterable[dict]:
    with dump_path.open("rb") as f:
        reader = FlowReader(f)
        i = 0
        for flow in reader.stream():
            if not isinstance(flow, HTTPFlow) or flow.response is None:
                continue

            start = flow.request.timestamp_start
            end = flow.response.timestamp_end
            duration = end - start
            req = flow.request
            res = flow.response

            yield {
                "index": i,
                "start_ts": round(start, 6),
                "end_ts": round(end, 6),
                "duration_s": round(duration, 6),
                "method": req.method,
                "host": req.host or "",
                "path": req.path or "",
                "status_code": res.status_code,
            }
            i += 1


def write_csv(flows: Iterable[dict], out: TextIO) -> int:
    writer = csv.writer(out)
    writer.writerow(FIELDS)
    count = 0
    for flow in flows:
        writer.writerow([flow[f] for f in FIELDS])
        count += 1
    return count


def write_json(flows: Iterable[dict], out: TextIO) -> int:
    items = list(flows)
    json.dump(items, out, indent=2)
    return len(items)


def visualize(flows: list[dict], image_file: str | None) -> None:
    if not flows:
        print("No HTTP flows to visualize", file=sys.stderr)
        return

    # DevTools-like: time relative to first request
    base = flows[0]["start_ts"]
    starts = [f["start_ts"] - base for f in flows]
    durations = [f["duration_s"] for f in flows]
    labels = [f'{f["method"]} {f["path"]}' for f in flows]

    n = len(flows)
    ys = list(range(n))

    # Scale height a bit with number of flows
    fig_height = max(4.0, min(0.25 * n, 20.0))
    fig, ax = plt.subplots(figsize=(12, fig_height))

    ax.barh(ys, durations, left=starts)
    ax.set_xlabel("Time since first request (s)")
    ax.set_ylabel("Request index")
    ax.set_title("HTTP Request Timeline (mitmproxy dump)")
    ax.invert_yaxis()

    # Y labels: truncate to avoid insane width
    max_label_len = 80
    ytick_labels = [
        (label if len(label) <= max_label_len else label[: max_label_len - 1] + "…")
        for label in labels
    ]
    ax.set_yticks(ys)
    ax.set_yticklabels(ytick_labels, fontsize=6)

    plt.tight_layout()

    if image_file:
        fig.savefig(image_file, dpi=150)
        print(f"Wrote visualization → {image_file}", file=sys.stderr)
    else:
        # Fall back to interactive window if no file
        plt.show()

    plt.close(fig)


def _parse_cli():
    parser = argparse.ArgumentParser(
        description="Extract and visualize HTTP flow timeline from mitmproxy dump."
    )
    parser.add_argument("dump_file", help="Path to the mitmproxy dump file")
    parser.add_argument(
        "--out-file",
        help="Output file. If omitted, write CSV/JSON to stdout.",
    )
    parser.add_argument(
        "--format",
        choices=["csv", "json"],
        default="csv",
        help="Output format (default: csv)",
    )
    parser.add_argument(
        "--visualize",
        action="store_true",
        help="Generate a waterfall-style PNG timeline.",
    )
    parser.add_argument(
        "--image-file",
        help="Output image file for visualization (default: timeline.png when --visualize is set).",
    )

    args = parser.parse_args()
    return args


def main(args: argparse.ArgumentParser) -> None:
    dump_path = pathlib.Path(args.dump_file)
    flows_list = list(iter_flows(dump_path))

    # textual output (csv/json)
    out_stream: TextIO
    if args.out_file:
        # newline="" to keep csv happy on Windows
        out_stream = open(args.out_file, "w", newline="")
    else:
        out_stream = sys.stdout

    if not args.visualize:
        try:
            if args.format == "csv":
                count = write_csv(flows_list, out_stream)
            else:
                count = write_json(flows_list, out_stream)
        finally:
            if args.out_file:
                out_stream.close()

        if args.out_file:
            print(f"Extracted {count} HTTP flows → {args.out_file}", file=sys.stderr)
    else args.visualize:
        image_file = args.image_file or "timeline.png"
        visualize(flows_list, image_file=image_file)


if __name__ == "__main__":
    args = _parse_cli()
    main(args)
