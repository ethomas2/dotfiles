#!/bin/bash
set -eo pipefail

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  cat <<EOF
Usage: git ba <--create | --latest>

Create or find backup branches for the current branch.

Options:
  -c, --create   Create a timestamped backup branch from HEAD
  -l, --latest   Print the most recent backup branch name
  -h, --help     Show this help message
EOF
  exit 0
fi

CUR_BRANCH=`git rev-parse --abbrev-ref HEAD`
NEW_BRANCH="${CUR_BRANCH}_backup-$(date +%Y.%m.%d-%H.%M.%S)"

if [ "$1" == "--create" ] || [ "$1" = "-c" ]; then
  git branch "$NEW_BRANCH"
  echo "$NEW_BRANCH"
elif [ "$1" == "--latest" ] || [ "$1" == "-l" ]; then
  echo $(git br | grep $(git tb) |  grep -v "\*" | grep "_backup-" | sort | tail -1)
else
  echo -e "\033[31mInvalid argument. Must provide --create or --latest\033[m"
  exit 1
fi
