#!/bin/bash

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  cat <<EOF
Usage: git myprs [-b]

List my open pull requests. Uses hub CLI.

Options:
  -b           Open PRs in the browser instead of listing them
  -h, --help   Show this help message
EOF
  exit 0
fi

browse=false
while getopts ":b" opt; do
  case ${opt} in
    b ) # process option a
      browse=true
      ;;
    \? ) echo "Usage: cmd [-h] [-t]"
      ;;
  esac
done

if [[ $browse = true ]];  then
  hub browse -- "pulls/ethomas-hrp"
else
 # hub issue -c ethomas-hrp --include-pulls -s all "@#"
 hub issue -c ethomas-hrp --include-pulls -f "%U %t %n"
fi
