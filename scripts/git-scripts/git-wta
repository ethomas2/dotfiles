#!/bin/bash
set -eo pipefail

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  cat <<EOF
Usage: git wta [--no-ts] <name> [<commit>]

Given the argument <name>, create a worktree at
  worktrees/wt-<date>-<name>

and a branch of the same format to track that worktree

Arguments:
  name     Name suffix for the worktree branch
  commit   Starting point (default: HEAD)

Options:
  --no-ts      Omit the timestamp (worktree named wt-<name>)
  -h, --help   Show this help message
EOF
  exit 0
fi

if [ -z "$REPO_ROOT" ]; then
  echo -e "\033[31mNo REPO_ROOT defined\033[m"
  exit 1
fi

NO_TS=false
POSITIONAL=()
for arg in "$@"; do
  case $arg in
    --no-ts) NO_TS=true ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done
set -- "${POSITIONAL[@]}"

if [ -z "$1" ]; then
  echo "Usage: git wta <name>"
  exit 1
fi

INPUT="${1#wt-}"

(
  cd $REPO_ROOT
  COMMIT=${2:-HEAD}


  mkdir -p worktrees/
  if [ "$NO_TS" = true ]; then
    NAME="wt-$INPUT"
  else
    NAME="wt-$(date +%Y.%m.%d-%H.%M.%S)-$INPUT"
  fi


  git worktree add -b $NAME "worktrees/$NAME" $COMMIT
  (
    cd "worktrees/$NAME"
    [ -d $REPO_ROOT/experiments/ ] && ln -s $REPO_ROOT/experiments/
    [ -d $REPO_ROOT/writeups/ ] && ln -s $REPO_ROOT/writeups/
    [ -d $REPO_ROOT/scrap/ ] && ln -s $REPO_ROOT/scrap/
  )
  realpath "worktrees/$NAME"
)
