#!/bin/bash
set -eo pipefail

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  cat <<EOF
Usage: git wta [--ts] <name> [<commit>]

Given the argument <name>, create a worktree at
  worktrees/wt-<name>

and a branch of the same format to track that worktree

Arguments:
  name     Name suffix for the worktree branch
  commit   Starting point (default: HEAD)

Options:
  --ts         Add a timestamp (worktree named wt-<date>-<name>)
  -h, --help   Show this help message
EOF
  exit 0
fi

if [ -z "$REPO_ROOT" ]; then
  echo -e "\033[31mNo REPO_ROOT defined\033[m"
  exit 1
fi

USE_TS=false
POSITIONAL=()
for arg in "$@"; do
  case $arg in
    --ts) USE_TS=true ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done
set -- "${POSITIONAL[@]}"

if [ -z "$1" ]; then
  echo "Usage: git wta <name>"
  exit 1
fi

INPUT="${1#wt-}"

(
  cd $REPO_ROOT
  COMMIT=${2:-HEAD}


  mkdir -p worktrees/
  if [ "$USE_TS" = true ]; then
    NAME="wt-$(date +%Y.%m.%d-%H.%M.%S)-$INPUT"
  else
    NAME="wt-$INPUT"
  fi


  git worktree add -b $NAME "worktrees/$NAME" $COMMIT
  (
    cd "worktrees/$NAME"
    [ -d $REPO_ROOT/tasks.md ] && ln -s $REPO_ROOT/tasks.md  || true
    [ -d $REPO_ROOT/.claude/ ] && ln -s $REPO_ROOT/.claude/ || true
    [ -d $REPO_ROOT/experiments/ ] && ln -s $REPO_ROOT/experiments/ || true
    [ -d $REPO_ROOT/writeups/ ] && ln -s $REPO_ROOT/writeups/ || true
    [ -d $REPO_ROOT/scrap/ ] && ln -s $REPO_ROOT/scrap/ || true
    [ -d $REPO_ROOT/utility/ ] && ln -s $REPO_ROOT/utility/ || true

    [ -f $REPO_ROOT/projects/agent/.env ] && ln -s $REPO_ROOT/projects/agent/.env || true
    [ -f $REPO_ROOT/projects/server-v2/.env ] && ln -s $REPO_ROOT/projects/server-v2/.env || true
    [ -f $REPO_ROOT/server/.env ] && ln -s $REPO_ROOT/server/.env || true
  )
  realpath "worktrees/$NAME"
)
